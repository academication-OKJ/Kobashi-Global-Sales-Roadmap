/* ===== LOGIC (pure calculation, no UI) ===== */
const $=i=>document.getElementById(i),C=CALCULATOR_SETTINGS,P=PRODUCT_DATA,IDS=["cnt","mn","pc","pk","kc","rate"];
let L="ja",type=C.defaults.type;try{L=localStorage.getItem("kk_l")||"ja"}catch(e){}if(!LANGUAGE_DATA[L])L="ja";
const t=k=>LANGUAGE_DATA[L][k]!==undefined?LANGUAGE_DATA[L][k]:LANGUAGE_DATA.ja[k];
const fmt=(n,d=1)=>n.toLocaleString(C.locale[L],{maximumFractionDigits:d}),yen=n=>"¥"+fmt(n,0);
function num(id){const e=$(id);if(e.value==="")return null;const v=parseFloat(e.value),bad=!isFinite(v)||v<0;e.classList.toggle("bad",bad);e.setAttribute("aria-invalid",bad);return bad?null:Math.min(v,C.max[id])}
function simulate(){const cnt=num("cnt"),mn=num("mn"),pc=num("pc"),pk=num("pk"),kc=num("kc"),rate=num("rate");
const h=c=>c!==null&&mn!==null?c*mn/60:null,cost=(c,p)=>c!==null&&p!==null?c*p:null;
return{cnt,mn,pc,pk,rate,cur:{h:h(cnt),cost:cost(cnt,pc)},asm:kc===null?null:{cnt:kc,h:h(kc),cost:cost(kc,pk)}}}
/* ===== UI ===== */
const cLabel=n=>({ja:"年"+n+"回"+(n===4?"以上":""),en:n+"×/yr"+(n===4?"+":""),vi:n+" lần/năm"+(n===4?"+":"")})[L],mLabel=m=>m+({ja:"分",en:" min",vi:" phút"})[L];
function chips(){$("c_type").innerHTML=C.types.map(k=>`<button type="button" class="chip" data-k="type" data-v="${k}">${t(k)}</button>`).join("");
$("c_cnt").innerHTML=C.chips.cnt.map(v=>`<button type="button" class="chip" data-k="cnt" data-v="${v}">${cLabel(v)}</button>`).join("");
$("c_mn").innerHTML=C.chips.mn.map(v=>`<button type="button" class="chip" data-k="mn" data-v="${v}">${mLabel(v)}</button>`).join("")}
function mark(){document.querySelectorAll("#sim .chip[data-k]").forEach(b=>b.setAttribute("aria-pressed",b.dataset.k==="type"?type===b.dataset.v:$(b.dataset.k).value===b.dataset.v))}
const line=(k,v)=>`<div class="big"><span>${t(k)}</span><b>${v}</b></div>`;
function calc(){const S=simulate(),H=v=>v===null?"–":fmt(v)+" "+t("hu"),Y=v=>v===null?`<small style="font-size:.85rem;font-weight:400">${t("r_none")}</small>`:yen(v);
const ref=type==="std"?"ref_std":type==="z"?"ref_z":"ref_both";
$("ba").innerHTML=`<div class="card"><span class="tag" style="background:var(--mu)">${t("r_cur")}</span>${line("r_cnt",S.cnt===null?"–":fmt(S.cnt)+" "+t("cu"))}${line("r_one",S.mn===null?"–":fmt(S.mn,0)+" "+t("mu"))}${line("r_hrs",H(S.cur.h))}${line("r_cost",Y(S.cur.cost))}</div>
<div class="arr" aria-hidden="true">▼</div>
<div class="card after"><span class="tag">${t("r_kiw")}</span><ul><li>${t("kb1")}</li><li>${t("kb2")}</li><li>${t("kb3")}</li></ul><p style="font-weight:700;margin:10px 0 4px">${t(ref)}</p><p class="mu" style="margin:0;font-size:.95rem">${t("ksim")}</p></div>`;
let x="";
if(S.asm){const a=S.asm;let m="";if(S.cnt!==null){const d=S.cnt-a.cnt;m=d>0?t("d_less").replace("{c}",fmt(d)).replace("{h}",S.cur.h!==null&&a.h!==null?fmt(S.cur.h-a.h):"–"):d===0?t("d_eq"):t("d_more")}
if(S.cur.cost!==null&&a.cost!==null){const d=S.cur.cost-a.cost;m+=" "+(d>0?t("c_less").replace("{v}",yen(d)):d<0?t("c_more").replace("{v}",yen(-d)):t("c_eq"))}
x+=`<div class="card"><h3>${t("asm_h")}</h3>${line("r_cnt",fmt(a.cnt)+" "+t("cu"))}${line("r_hrs",H(a.h))}${line("r_cost",Y(a.cost))}<p>${m}</p></div>`}
if(S.pc!==null||S.pk!==null)x+=`<div class="card"><h3>${t("r_set")}</h3>${line("r_cur",S.pc===null?"–":yen(S.pc))}${line("r_kiw",S.pk===null?"–":yen(S.pk))}<p class="mu" style="font-size:.95rem">${t("opt_n")}</p></div>`;
if(S.rate!==null&&S.cur.h!==null)x+=`<div class="card"><h3>${t("val_h")}</h3>${line("r_cur",yen(S.cur.h*S.rate))}${S.asm&&S.asm.h!==null?line("r_kiw",yen(S.asm.h*S.rate)):""}</div>`;
$("extra").innerHTML=x;$("rq").textContent=S.cur.h!==null&&S.cur.h>0?t("q_hrs").replace("{h}",fmt(S.cur.h)):"";
try{const o={type};IDS.forEach(i=>o[i]=$(i).value);localStorage.setItem(C.key,JSON.stringify(o))}catch(e){}mark()}
const blade=(hw,ty)=>`<svg viewBox="0 0 60 92" width="48" height="74" aria-hidden="true"><path d="M18 0H42V40L${30+hw} ${ty}H${30-hw}L18 40Z" fill="#8a6a4a"/></svg>`;
function pri(){const on=[...document.querySelectorAll("#ckg input:checked")].map(x=>+x.value),a=on.some(i=>P.goalsA.includes(i)),b=on.some(i=>P.goalsB.includes(i));
$("pres").innerHTML=!on.length?t("pr0"):(a?`<p style="margin:0 0 8px">${t("pr_a")}</p>`:"")+(b?`<p style="margin:0">${t("pr_b")}</p>`:"")}
const mdl=()=>$("mdb").classList.toggle("hide",!$("md").value.trim());
function render(){document.documentElement.lang=L;document.title=t("title");
document.querySelectorAll("[data-i]").forEach(e=>{const v=t(e.dataset.i);if(typeof v==="string")e.textContent=v});
document.querySelectorAll("[data-l]").forEach(b=>b.setAttribute("aria-pressed",b.dataset.l===L));
chips();
$("stg").innerHTML=t("stg").split("|").map((s,i)=>`<div>${blade([6,9,15,20][i],[86,80,66,58][i])}<br>${s}</div>`).join("");
$("each").innerHTML=t("each").map(x=>`<li>${x}</li>`).join("");
$("lay").innerHTML=P.kiwami.layers.map(([k,c],i)=>`<div style="background:${c};padding:${i===2?"34px":"14px"} 14px">${t(k)}</div>`).join("");
const w=P.kiwami.wear,bar=(n,v,max,c)=>`<div class="bar"><p>${n}</p><div class="track"><i style="width:${v/max*100}%;background:${c}">${v}</i></div></div>`;
$("wbar").innerHTML=`<p class="mu" style="margin:0">${t("g1")}</p>`+bar(t("bs"),100,100*w.vsStandard,"#a89f86")+bar(t("bk")+" (≈)",100*w.vsStandard,100*w.vsStandard,"#4f6f4c")+`<p class="mu" style="margin:14px 0 0">${t("g2")}</p>`+bar(t("bz"),100,100*w.vsZ,"#a89f86")+bar(t("bk")+" (≈)",100*w.vsZ,100*w.vsZ,"#4f6f4c");
$("fam").innerHTML=t("fam").map(x=>`<li>${x}</li>`).join("");
const on=[...document.querySelectorAll("#ckg input:checked")].map(x=>+x.value);
$("ckg").innerHTML=t("pr").map((x,i)=>`<label><input type="checkbox" value="${i}" ${on.includes(i)?"checked":""}>${x}</label>`).join("");
$("mlist").innerHTML=MACHINE_DATA.prefixes.map(p=>`<option value="${p}">`).join("");$("mex").textContent=t("md_ex")+MACHINE_DATA.prefixes.join(" / ");
$("steps").innerHTML=t("steps").map(x=>`<li>${x}</li>`).join("");$("notes").innerHTML=t("notes").map(x=>`<li>${x}</li>`).join("");
$("cat").href=P.links.catalog;$("mdb").href=P.links.modelSearch;pri();mdl();calc()}
try{const s=JSON.parse(localStorage.getItem(C.key)||"null")||Object.assign({},C.defaults);type=s.type||type;IDS.forEach(i=>{$(i).value=s[i]!==undefined?s[i]:(C.defaults[i]||"")})}catch(e){IDS.forEach(i=>$(i).value=C.defaults[i]||"")}
document.addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;
if(b.dataset.l){L=b.dataset.l;try{localStorage.setItem("kk_l",L)}catch(x){}render()}
else if(b.dataset.k==="type"){type=b.dataset.v;calc()}else if(b.dataset.k){$(b.dataset.k).value=b.dataset.v;calc()}});
document.addEventListener("input",e=>{if(IDS.includes(e.target.id))calc();if(e.target.id==="md")mdl()});
$("ckg").addEventListener("change",pri);
$("reset").onclick=()=>{type=C.defaults.type;IDS.forEach(i=>$(i).value=C.defaults[i]||"");calc()};
render();
</script>
</body>
</html>
